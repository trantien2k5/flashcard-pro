# ==============================================================================
# Flashcard English Pro - Git Ignore Rules
# ==============================================================================

# OS & System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Internal Developer Tools & Scripts (Giữ cục bộ trên máy dev)
tools/

# Local Image Browser Folder (Tránh nhân đôi 500MB trên GitHub)
assets/images/by_topic/

# Temporary, Cache & Scratch Files
scratch/
.temp/
.tmp/
*.tmp
*.bak
*.backup
.cache/
